# The Vercel CLI does not read .gitignore, only this file. Keep it in step with .gitignore.
# Dependencies are installed and the app is built on Vercel; none of this should be uploaded.
node_modules
dist
/public
coverage
.vite
*.tsbuildinfo

# secrets and local state
.env
.env.*
.vercel
*.db
*.db-journal
*.db-shm
*.db-wal

# local data and tooling output
ollama_models
graphify-out
apps/server/src/generated
*.log
.git
.idea
.vscode
