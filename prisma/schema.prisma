// Accounts and sessions only (Phase 12). Entitlements, payments and subscriptions are deliberately
// not modelled yet - they arrive with the payment phase (see docs/architecture.md, 6b).

generator client {
  provider = "prisma-client"
  output   = "../apps/server/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(uuid())
  /// Trimmed and lower-cased before every lookup and write (see apps/server/src/auth.ts).
  email        String    @unique
  /// scrypt hash string with its own salt and cost parameters; never the password.
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  /// SHA-256 of the session token; the raw token only ever exists in the user's cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}
