# Copy to `.env` for local overrides. Every value below is optional; these are the defaults.
# All commands (dev, start, db:*) are run from the repository root, so relative paths are
# relative to the repository root.

NODE_ENV=development
PORT=3001
DATABASE_URL=file:./prisma/dev.db
# debug | info | warn | error | silent  (default: debug in dev, info in production, silent in tests)
LOG_LEVEL=debug
