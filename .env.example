# Copy to `.env` for local overrides. Every value below is optional; these are the defaults.
# All commands (dev, start, db:*) are run from the repository root, so relative paths are
# relative to the repository root.

NODE_ENV=development
PORT=3001
DATABASE_URL=file:./prisma/dev.db
# debug | info | warn | error | silent  (default: debug in dev, info in production, silent in tests)
LOG_LEVEL=debug

# The site's real production origin, no trailing slash (e.g. https://toolora.com). Read by both the
# web app (Vite exposes VITE_-prefixed vars to client code) and the server (sitemap.xml, robots.txt) —
# see docs/architecture.md, "SEO strategy". Unset in development: canonical/OG/sitemap URLs fall back
# to same-origin-relative, and sitemap.xml is not served, until a real domain exists. Never set this
# to a placeholder like https://example.com.
VITE_PUBLIC_SITE_URL=
